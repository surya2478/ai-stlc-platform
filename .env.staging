# ── Staging environment template ──────────────────────────────────────────────
# Do NOT commit real values. Populate via CI secrets or a secrets manager.
# Values shown are required variable names with placeholder descriptions.

APP_ENV=staging
APP_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
ALLOWED_ORIGINS=https://staging.yourdomain.com

POSTGRES_USER=stlc_staging
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=stlc_staging
DATABASE_URL=postgresql://stlc_staging:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/stlc_staging

REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# LLM — use cloud provider in staging for parity with production
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEFAULT_VISION_MODEL=gpt-4o-mini

GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Jira — real connection in staging; keep simulation off
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=REPLACE_WITH_JIRA_EMAIL
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN
JIRA_PROJECT_KEY=STLC
JIRA_SIMULATION_MODE=false
JIRA_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_MIN_32_CHARS

# Dev features — must be disabled in staging
DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_EMAIL=
DEV_SEED_USER_PASSWORD=

REAL_TEST_EXECUTION=false
RUN_AGENTS_SYNCHRONOUSLY=false

# RAG
RAG_ENABLED=true
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Data retention
RETENTION_AGENT_LOGS_DAYS=30
RETENTION_RAG_EVENTS_DAYS=90
RETENTION_UPLOADED_FILES_DAYS=180

# Frontend
NEXT_PUBLIC_API_URL=https://staging.yourdomain.com
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
