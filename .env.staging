# ── Staging environment template ──────────────────────────────────────────────
# Do NOT commit real values. Populate via CI secrets or a secrets manager.
# Values shown are required variable names with placeholder descriptions.

APP_ENV=staging
APP_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
# HTTPS is published on 12443 (443 is taken on the target host), so the
# port is part of the origin. An origin without it will not match and
# every browser request is refused by CORS.
ALLOWED_ORIGINS=https://staging.yourdomain.com:12443

POSTGRES_USER=stlc_staging
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=stlc_staging
DATABASE_URL=postgresql://stlc_staging:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/stlc_staging

# Both are needed and must agree: compose passes REDIS_PASSWORD to
# `redis-server --requirepass` and refuses to run without it, while the
# application connects with the full REDIS_URL.
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# LLM — use cloud provider in staging for parity with production
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEFAULT_VISION_MODEL=gpt-4o-mini

GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Jira — real connection in staging; keep simulation off
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=REPLACE_WITH_JIRA_EMAIL
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN
JIRA_PROJECT_KEY=STLC
JIRA_SIMULATION_MODE=false
JIRA_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_MIN_32_CHARS

# Dev features — must be disabled in staging
DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_EMAIL=
DEV_SEED_USER_PASSWORD=

REAL_TEST_EXECUTION=false
RUN_AGENTS_SYNCHRONOUSLY=false

# Automation runners — required, not optional. The built-in default is "local",
# which is refused outside app_env=local, so leaving this block unset means the
# runner policy rejects every automation run rather than falling back to
# something weaker. "executor" hands the bundle to the credential-free
# runner-executor service, the only process that holds the Docker socket.
AUTOMATION_RUNNER_MODE=executor
AUTOMATION_EXECUTOR_URL=http://runner-executor:8100
# Minimum 32 chars; generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMATION_EXECUTOR_TOKEN=REPLACE_WITH_EXECUTOR_TOKEN
AUTOMATION_ALLOW_LOCAL_RUNNER=false
# Compose v2 prefixes both with the project directory name — override if yours differs.
AUTOMATION_DOCKER_IMAGE=stlc-platform-worker
AUTOMATION_DOCKER_VOLUME=stlc-platform_stlc_storage
AUTOMATION_DOCKER_STORAGE_MOUNT=/app/storage

# ── RAG / Knowledge Base ─────────────────────────────────────────────────────
# Off in code by default. With it on, uploaded documents and requirements are
# chunked, embedded and retrievable from the Knowledge Base workspace, and
# agents ground their output on the result.
RAG_ENABLED=true

# sentence_transformers runs locally and needs no key — it is a real
# dependency now (backend/requirements.txt), where it used to be selected by
# default but never installed, so indexing failed with an ImportError.
# The alternatives are "openai" and "huggingface"; each needs its provider's
# API key set above, and embedding text then leaves your network.
#
# Keep this matching production: embeddings from different models are not
# comparable, so a staging corpus built on another provider tells you nothing
# about how retrieval will behave in production.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# MUST match the model's output width and the vector(384) column that
# migration 018 creates. bge-small-en-v1.5 emits 384. Changing the model
# without migrating that column makes every insert fail with "expected 384
# dimensions" — the column is not derived from this setting.
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Retrieval shape. Candidates are fetched by both semantic and keyword search
# and merged; context is how many survive into the prompt. The weights sum to
# 1.0 and bias that merge. Worth tuning here rather than in production.
RAG_TOP_K_CANDIDATES=20
RAG_TOP_K_CONTEXT=5
RAG_SEMANTIC_WEIGHT=0.65
RAG_KEYWORD_WEIGHT=0.35

# Two operational consequences of the local provider, both worth planning for:
#   - The model is downloaded from HuggingFace on first embed. A locked-down
#     host needs egress for it, or the cache baked into the image.
#   - It pulls torch, which is why the backend image is ~4.7GB rather than 3GB.
#     Pinned to the CPU wheel; a CUDA build would add roughly 2.5GB more.

# Data retention
RETENTION_AGENT_LOGS_DAYS=30
RETENTION_RAG_EVENTS_DAYS=90
RETENTION_UPLOADED_FILES_DAYS=180

# Frontend
NEXT_PUBLIC_API_URL=https://staging.yourdomain.com:12443
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
