# ── Development environment template ─────────────────────────────────────────
# Copy to .env for local development.
# All secrets here are example values — change them before use.
# This file is safe to commit (no real credentials).

APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-key-change-me-min-32-chars!!
# 3000 and 8000 are off-limits on the shared host; the compose override
# publishes the app on 4300 and the API on 8400.
ALLOWED_ORIGINS=http://localhost:4300,http://localhost:8400

POSTGRES_USER=stlc_local
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=stlc_agents
DATABASE_URL=postgresql://stlc_local:local-dev-password@db:5432/stlc_agents

# Both are needed and must agree: compose passes REDIS_PASSWORD to
# `redis-server --requirepass` and refuses to run without it, while the
# application connects with the full REDIS_URL.
REDIS_PASSWORD=local-dev-redis-password
REDIS_URL=redis://:local-dev-redis-password@redis:6379/0

FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# LLM — default to Ollama for local dev (no cloud cost)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_VISION_MODEL=llava
# Blank = same model as DEFAULT_LLM_MODEL. Set DEFAULT_REVIEW_MODEL to a
# different model so reviewers don't share the generator's blind spots.
DEFAULT_REVIEW_MODEL=
DEFAULT_RAG_MODEL=

# Cloud LLM providers — leave empty unless testing
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=

# OpenRouter — set DEFAULT_LLM_PROVIDER=openrouter to use it, and change
# DEFAULT_LLM_MODEL/DEFAULT_VISION_MODEL above to OpenRouter slugs: the
# DEFAULT_* values win over OPENROUTER_MODEL, so the Ollama tags above would
# otherwise be sent to the API verbatim.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Jira — simulation mode by default in development
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_SIMULATION_MODE=true
JIRA_WEBHOOK_SECRET=

# Dev conveniences — NEVER enable in production
DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_EMAIL=dev@example.com
DEV_SEED_USER_PASSWORD=DevPassword123!

REAL_TEST_EXECUTION=false
RUN_AGENTS_SYNCHRONOUSLY=true

# Automation runners. "local" runs generated test code inside the worker and is
# permitted only when APP_ENV=local, which is why it is the development default.
# AUTOMATION_EXECUTOR_TOKEN is still required: docker-compose.yml passes it to
# the runner-executor service unconditionally and compose refuses to start —
# every service, not just that one — when it is unset.
AUTOMATION_RUNNER_MODE=local
AUTOMATION_EXECUTOR_URL=http://runner-executor:8100
# Minimum 32 chars; generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMATION_EXECUTOR_TOKEN=local-dev-executor-token-change-me-min-32-chars
# AUTOMATION_ALLOW_LOCAL_RUNNER is deliberately unset: it derives from APP_ENV,
# allowing the local runner on "local" and refusing it everywhere else. Setting
# it here would carry that permission into any file copied from this one.
# Compose v2 prefixes both with the project directory name — override if yours differs.
AUTOMATION_DOCKER_IMAGE=stlc-platform-worker
AUTOMATION_DOCKER_VOLUME=stlc-platform_stlc_storage
AUTOMATION_DOCKER_STORAGE_MOUNT=/app/storage

# RAG — disabled by default (requires pgvector + sentence-transformers)
RAG_ENABLED=false
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Data retention (shorter in dev for faster testing)
RETENTION_AGENT_LOGS_DAYS=7
RETENTION_RAG_EVENTS_DAYS=30
RETENTION_UPLOADED_FILES_DAYS=90

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8400
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
