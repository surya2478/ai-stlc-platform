APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret
# 3000 and 8000 are reserved on the shared host; the compose override publishes
# the app on 4300 and the API on 8400.
ALLOWED_ORIGINS=http://localhost:4300,http://localhost:8400

POSTGRES_USER=stlc_local
POSTGRES_PASSWORD=replace-local-postgres-password
POSTGRES_DB=stlc_agents
DATABASE_URL=postgresql://stlc_local:replace-local-postgres-password@db:5432/stlc_agents
# Both are needed and must agree: compose passes REDIS_PASSWORD to
# `redis-server --requirepass` and refuses to run without it, while the
# application connects with the full REDIS_URL.
REDIS_PASSWORD=replace-local-redis-password
REDIS_URL=redis://:replace-local-redis-password@redis:6379/0

FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://ollama:11434

# GAP-1: vision model for UI screenshot analysis.
# Ollama: pull a multimodal model first, e.g. `ollama pull llava` or `ollama pull qwen2.5vl`.
# OpenAI-compatible: set to any vision-capable model (e.g. gpt-4o-mini).
DEFAULT_VISION_MODEL=llava

# ── AI Gateway: 3-model role routing ──────────────────────────────
#   coding    -> LLM_CODING_MODEL     (test cases, automation scripts)
#   vision    -> LLM_VISION_MODEL     (screenshots, OCR, PDFs)
#   reasoning -> LLM_REASONING_MODEL  (planning, agents, review, chat)
# When AI_GATEWAY_ENABLED=false, legacy DEFAULT_LLM_* behavior applies.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_BASE_URL=            # e.g. http://ai-gateway:4000/v1
AI_GATEWAY_API_KEY=
LLM_CODING_MODEL=qwen3-coder-next
LLM_VISION_MODEL=qwen3-vl-8b
LLM_REASONING_MODEL=gpt-oss-20b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_SIMULATION_MODE=true

REAL_TEST_EXECUTION=false
RUN_AGENTS_SYNCHRONOUSLY=true

# Automation runners. "local" runs generated test code inside the worker and is
# permitted only when APP_ENV=local. AUTOMATION_EXECUTOR_TOKEN is required even
# so: docker-compose.yml passes it to the runner-executor service
# unconditionally and compose refuses to start without it.
AUTOMATION_RUNNER_MODE=local
AUTOMATION_EXECUTOR_URL=http://runner-executor:8100
# Minimum 32 chars; generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMATION_EXECUTOR_TOKEN=replace-with-a-local-executor-token-min-32-chars
# AUTOMATION_ALLOW_LOCAL_RUNNER is deliberately unset: it derives from APP_ENV,
# allowing the local runner on "local" and refusing it everywhere else.
# Compose v2 prefixes both with the project directory name — override if yours differs.
AUTOMATION_DOCKER_IMAGE=stlc-platform-worker
AUTOMATION_DOCKER_VOLUME=stlc-platform_stlc_storage
AUTOMATION_DOCKER_STORAGE_MOUNT=/app/storage

DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_EMAIL=
DEV_SEED_USER_PASSWORD=

NEXT_PUBLIC_API_URL=http://localhost:8400
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
NEXT_PUBLIC_DEV_AUTH_EMAIL=
NEXT_PUBLIC_DEV_AUTH_PASSWORD=

# ── Assistant Settings ───────────────────────────────────────────────────
ASSISTANT_ENABLED=true
ASSISTANT_PROJECT_DATA_ENABLED=true
ASSISTANT_RAG_ENABLED=true
ASSISTANT_HISTORY_ENABLED=true
ASSISTANT_MAX_TOKENS=2048
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
ASSISTANT_ALLOWED_ROLES=admin,qa_engineer,qa_lead,viewer
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_MODEL_PROFILE=

AUTOMATION_CLASSIFICATION_ENABLED=true
AUTOMATION_CLASSIFICATION_AGENT_ENABLED=true
