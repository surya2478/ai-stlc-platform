.env
# `.env` alone did not cover a copy of it. A `.env.backup-<timestamp>` sitting
# in the working tree was untracked but committable, so a blanket `git add`
# would have published the real API keys, database password and JIRA token it
# holds. Anything derived from .env is ignored, and the templates are then
# allowed back explicitly.
.env.*
!.env.development
!.env.staging
!.env.production
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / frontend
node_modules/
dist/
build/
.next/
coverage/

# Certificates and private keys (SEC-058)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr
certs/
ssl/
tls/

# Logs and local files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
.write_test
layout-check/
frontend/.npm/
# The backend image runs as a user whose HOME is /app, so any container that
# bind-mounts the working tree there drops an npm cache into the repo.
backend/.npm/
*.tsbuildinfo

# Alembic generated (keep migrations, not local state)
alembic/versions/__pycache__/

# Security scan outputs (committed reports go in CI artifacts, not repo)
bandit-results.sarif
semgrep-results.sarif
pip-audit-report.json
npm-audit-report.json
eslint-security-report.json

# Secrets / credential files
*.secret
secrets/
.secrets

# Playwright MCP local output (snapshots/console logs written to CWD when
# running the discovery agent or its smoke tests outside a configured
# --output-dir)
.playwright-mcp/

# Celery beat's schedule state, written into the worker's CWD by the embedded
# scheduler (docker-compose worker runs with --beat). Runtime state, not source.
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
