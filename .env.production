# ── Production environment template ──────────────────────────────────────────
# NEVER commit real values. Use a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, GCP Secret Manager, etc.) to inject values at deploy time.
# All required variables are listed; placeholders indicate the expected format.

APP_ENV=production
APP_DEBUG=false
# Minimum 32 chars; generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_FROM_SECRETS_MANAGER
ALLOWED_ORIGINS=https://yourdomain.com

POSTGRES_USER=stlc_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_FROM_SECRETS_MANAGER
POSTGRES_DB=stlc_production
DATABASE_URL=postgresql://stlc_prod:REPLACE_WITH_STRONG_DB_PASSWORD_FROM_SECRETS_MANAGER@db:5432/stlc_production

REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD_FROM_SECRETS_MANAGER@redis:6379/0

# Pool tuning for production load
DB_POOL_ENABLED=true
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# LLM provider
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY_FROM_SECRETS_MANAGER
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
DEFAULT_VISION_MODEL=gpt-4o

# Jira
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN_FROM_SECRETS_MANAGER
JIRA_PROJECT_KEY=STLC
JIRA_SIMULATION_MODE=false
# Minimum 32 chars random string
JIRA_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_FROM_SECRETS_MANAGER

# Security hardening
PROMPT_GUARD_ENABLED=true

# Dev features — must all be false / empty in production
DEV_SEED_USER_ENABLED=false
DEV_SEED_USER_EMAIL=
DEV_SEED_USER_PASSWORD=
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

REAL_TEST_EXECUTION=false
RUN_AGENTS_SYNCHRONOUSLY=false

# Automation runners — required, not optional. The built-in default is "local",
# which runs generated test code inside the worker with the worker's own
# database, Redis and LLM credentials; it is refused outside app_env=local, so
# leaving this block unset means every automation run is rejected by the runner
# policy rather than falling back to something weaker. "executor" hands the
# bundle to the credential-free runner-executor service, the only process that
# holds the Docker socket (AUT-002).
AUTOMATION_RUNNER_MODE=executor
AUTOMATION_EXECUTOR_URL=http://runner-executor:8100
# Minimum 32 chars; generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMATION_EXECUTOR_TOKEN=REPLACE_WITH_EXECUTOR_TOKEN_FROM_SECRETS_MANAGER
AUTOMATION_ALLOW_LOCAL_RUNNER=false
# Image for spawned runner containers and the volume shared with them. Compose
# v2 prefixes both with the project directory name — override if yours differs.
AUTOMATION_DOCKER_IMAGE=stlc-platform-worker
AUTOMATION_DOCKER_VOLUME=stlc-platform_stlc_storage
AUTOMATION_DOCKER_STORAGE_MOUNT=/app/storage

# RAG
RAG_ENABLED=true
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

# Data retention (production-grade windows)
RETENTION_AGENT_LOGS_DAYS=90
RETENTION_RAG_EVENTS_DAYS=180
RETENTION_UPLOADED_FILES_DAYS=365

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com
INTERNAL_API_URL=http://backend:8000
